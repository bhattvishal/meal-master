          "items": [
            "1 cup soya granules",
            "1 large potato, boiled and mashed",
            "1 onion, very finely chopped",
            "1 tbsp ginger-garlic paste",
            "2 tbsp besan (roasted, to bind)",
            "1 tsp garam masala",
            "1 tsp red chilli powder",
            "1/2 tsp chaat masala",
