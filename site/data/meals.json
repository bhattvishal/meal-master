      ],
      "notionUrl": "https://www.notion.so/3e7df18afa0e816dbebbec1acd2fae48",
      "intro": "Roughly 25 g protein per serving. Start the soaking the night before.",
      "sections": [
        {
          "title": "Ingredients",
          "kind": "list",
          "items": [
            "1/2 cup rajma (or white beans)",
            "1/2 cup chhole (chickpeas)",
            "150 g paneer, cubed",
            "1 onion, finely chopped",
            "1 tomato, deseeded and finely chopped",
            "1/2 cucumber, finely chopped",
            "Handful of coriander, chopped",
            "1 green chilli, slit (optional)",
            "1 tsp ghee or olive oil (for toasting paneer)"
          ]
        },
        {
          "title": "Dressing",
          "kind": "list",
          "items": [
            "Juice of 1 lemon",
            "1 tsp olive oil",
            "1/2 tsp roasted cumin powder",
            "Pinch of chaat masala",
            "Salt and black pepper"
          ]
        },
        {
          "title": "Method",
          "kind": "steps",
          "items": [
            "Soak the rajma and chhole overnight.",
            "Pressure cook with salt until soft but still holding shape (about 4-5 whistles). Cool completely.",
            "Toast the paneer cubes in ghee or olive oil, about 2 minutes per side, until lightly coloured. Season with salt and pepper.",
            "Whisk the dressing ingredients together.",
            "Toss everything with the coriander and green chilli.",
            "Rest 10 minutes before eating so the beans soak up the dressing."
          ]
        }
      ]
    },
